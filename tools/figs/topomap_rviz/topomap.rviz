Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Cell Size: 10
      Plane Cell Count: 20
      Color: 110; 110; 110
      Enabled: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Topomap
      Topic:
        Value: /topomap_markers
      Enabled: true
  Enabled: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Top
      Scale: 8.2
      X: 41.5
      Y: -1.5
      Angle: 0
  Tools:
    - Class: rviz_default_plugins/MoveCamera
Window Geometry:
  Displays:
    collapsed: true
  Height: 1000
  Width: 1800
  X: 100
  Y: 60
  Hide Left Dock: true
  Hide Right Dock: true
