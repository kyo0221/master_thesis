# 再同定パラメータ。値を書き換えて run_reid.sh（または `source reid_params.env` してから jobs_reid.py）を使う。
# 値は 2026-10-31 の再同定値。再同定前の値（sil.py/jobs.py の既定）: VTAU0.60 VG0.965 VDEL0.06 AMAX2.5 DMAX3.5 STAU0.17 SDEL0.06 K0.92 LAT0.06 コーン9.3 パネル20 COM_B0.05 WHITE0.01 TIP_B0.25 TIP_RHO0.7 CUT_P0.1


# ---- 車両（jobs.py の VEH を丸ごと差し替える。SIL_STAU を含めると操舵時定数の既定になる）
REID_VTAU=0.24      # 並進速度の一次遅れ [s]
REID_VG=0.99       # 並進速度の定常ゲイン
REID_VDEL=0.05      # 並進速度のむだ時間 [s]
REID_AMAX=3.4       # 加速の上限 [m/s^2]
REID_DMAX=4.0       # 減速の上限 [m/s^2]
REID_STAU=0.22      # 操舵の時定数 [s]
REID_SDEL=0.05      # 操舵のむだ時間 [s]
REID_K=1.07         # 操舵のゲイン
export SIL_VEH_OVERRIDE="SIL_VTAU=$REID_VTAU SIL_VG=$REID_VG SIL_VDEL=$REID_VDEL SIL_AMAX=$REID_AMAX SIL_SDEL=$REID_SDEL SIL_K=$REID_K SIL_DMAX=$REID_DMAX SIL_STAU=$REID_STAU"

# ---- 認識・検出・遅延・実測誤差モデル（全 job の env に入る。実測誤差モデルは SIL_REALNOISE=1 の条件だけで効く）
REID_LAT=0.07       # 撮影から経路生成の出力までの遅延 [s]（SIL_LAT）
REID_PYLON_R=17.7    # コーンの最遠検知距離 [m]（SIG_PYLON_R）
REID_PANEL_R=22.9     # 信号パネルの最遠検知距離 [m]（SIG_PANEL_R。sil.py の未指定時の挙動は max(20, コーン検知距離)）
REID_COM_B=0.045     # 胴体（全行共通）のラプラス尺度 [m]
REID_COM_RHO=0.65   # 胴体の自己相関 ρ（15 Hz 1 ステップ）
REID_WHITE=0.03     # 行ごとの白色雑音の標準偏差 [m]
REID_TIP_B=0.28     # 先端（最遠の 1 点）のラプラス尺度 [m]
REID_TIP_RHO=0.78    # 先端の自己相関 ρ
REID_CUT_P=0.23      # 最遠の点が出ない（経路が 5.8 m で途切れる）フレームの割合
REID_HORIZON=9.0    # 認識距離（経路の切り出し距離）[m]
REID_ROWS=0.769,0.806,0.847,0.892,0.943,0.999,1.062,1.133,1.215,1.31,1.42,1.551,1.708,1.901,2.142,2.453,2.869,3.454,4.339,5.832,8.888   # 行位置 [m]（コンマ区切り・空白なし）
export SIL_PARAM_ENV="SIL_LAT=$REID_LAT SIG_PYLON_R=$REID_PYLON_R SIG_PANEL_R=$REID_PANEL_R SIL_REAL_COM_B=$REID_COM_B SIL_REAL_COM_RHO=$REID_COM_RHO SIL_REAL_WHITE=$REID_WHITE SIL_REAL_TIP_B=$REID_TIP_B SIL_REAL_TIP_RHO=$REID_TIP_RHO SIL_REAL_CUT_P=$REID_CUT_P SIL_REAL_HORIZON=$REID_HORIZON SIL_REAL_ROWS=$REID_ROWS"

# ---- 出力先（既存の res/ とは混ぜない）と走行打切りの余裕
export SIL_OUT=${SIL_OUT:-out_reid}
export SIL_STOP_MARGIN=${SIL_STOP_MARGIN:-5.0}   # 周数×周長 + 5 m で打切り（開始線の通過を取り逃さない）
