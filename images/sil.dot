// 手動配置のため neato -n2 で生成する: neato -n2 -Tpng -Gdpi=200 sil.dot -o sil.png
// (dot では実装側と同定モデルの2段配置、タイトルと矢印の重なり回避が安定しなかった。ラベルは plaintext ノード、tr->veh は pos で手描き)
digraph G { splines=line;
node [shape=box, style="rounded,filled", fontname="Noto Sans CJK JP", fontsize=11]; edge [fontname="Noto Sans CJK JP", fontsize=9];
box_impl [label="Implemented software (unchanged)", shape=box, style=dashed, fillcolor=white, fixedsize=true, width=10.2, height=3.0, labelloc=t, fontsize=12, pos="350,190!"];
box_model [label="Models identified from driving records", shape=box, style=dashed, fillcolor=white, fixedsize=true, width=10.2, height=1.9, labelloc=b, fontsize=12, pos="350,-18!"];
sm [label="Path smoothing", fillcolor="#f2f2f2", pos="70,235!"]; lp [label="Frenet\nlocal planner", fillcolor="#f2f2f2", pos="250,235!"]; stp [label="Stop point\ngeneration", fillcolor="#f2f2f2", pos="400,150!"]; sp [label="Velocity planning", fillcolor="#f2f2f2", pos="470,235!"]; tr [label="Path following", fillcolor="#f2f2f2", pos="620,235!"];
pg [label="Path generation model\n(lane center + noise)", fillcolor="#fde9d9", pos="90,5!"]; veh [label="Vehicle model\n(delay, lag, limits)", fillcolor="#fde9d9", pos="270,5!"]; det [label="Detection model\n(range)", fillcolor="#fde9d9", pos="480,5!"];
node [shape=plaintext, style=filled, fillcolor=white, fontsize=9, margin="0.02,0.01", width=0.1, height=0.1];
l1 [label="pose", pos="180,18!"]; l2 [label="pose", pos="375,18!"]; l3 [label="pose", pos="143,125!"]; l4 [label="pose", pos="284,125!"]; l5 [label="pose, velocity", pos="568,168!"]; l6 [label="command", pos="668,100!"];
sm -> lp; lp -> sp; stp -> sp; sp -> tr; pg -> sm; det -> lp; det -> stp;
veh -> pg; veh -> det; veh -> sm; veh -> lp; veh -> tr [tailport=e, headport=s];
tr -> veh [pos="e,270,-12 648,217 715,160 712,-34 600,-34 420,-36 270,-52 270,-23"]; }
